  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 167108f80ae458341997f4b2886f5148, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  displayImage: {fileID: 1246610484}
  displayText: {fileID: 741395586}
  skipButton: {fileID: 2103397544}
  posterCanvasGroup: {fileID: 597228313}
  posterDisplayDuration: 2
  posterFadeDuration: 1.5
  storyCanvasGroup: {fileID: 1854735602}
  storyFadeDuration: 0.5
  audioSource: {fileID: 602229356}
  posterAudioClip: {fileID: 0}
  storyAudioClip: {fileID: 0}
  maxAudioVolume: 0.7
  introScenes:
  - illustration: {fileID: 7980553876111591520, guid: 02b06bca03931a64d9615fe7ede34cff, type: 3}
    narrativeText: "T\xEAn l\xE0 Kakarot, ta \u0111\u01B0\u1EE3c g\u1EEDi \u0111\u1EBFn
      Tr\xE1i \u0110\u1EA5t t\u1EEB h\xE0nh tinh Vegeta xa x\xF4i v\u1EDBi s\u1EE9
      m\u1EC7nh h\u1EE7y di\u1EC7t..."
  - illustration: {fileID: -3267135995505635833, guid: 85a6455ce97dfd24a8def66f30020c14, type: 3}
    narrativeText: "Nh\u01B0ng m\u1ED9t tai n\u1EA1n \u0111\xE3 khi\u1EBFn ta qu\xEAn
      s\u1EA1ch m\u1ECDi th\u1EE9. \xD4ng n\u1ED9i Gohan l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u
      ti\xEAn t\xECm th\u1EA5y, c\u01B0u mang v\xE0 \u0111\u1EB7t t\xEAn cho ta l\xE0...
      Son Goku."
  - illustration: {fileID: -1673793635290219477, guid: efc90f4ae75f2d64bb2d3b2984a81343, type: 3}
    narrativeText: "\xD4ng n\u1ED9i d\u1EA1y ta v\xF5 thu\u1EADt, d\u1EA1y ta c\xE1ch
      s\u1ED1ng. Vi\xEAn ng\u1ECDc 4 sao n\xE0y l\xE0 k\u1EF7 v\u1EADt cu\u1ED1i
      c\xF9ng \xF4ng \u0111\u1EC3 l\u1EA1i cho ta, nh\u01B0 m\u1ED9t l\u1EDDi nh\u1EAFc
      nh\u1EDF v\u1EC1 t\xECnh th\xE2n.\""
  - illustration: {fileID: 6067455824938895809, guid: 4c05c400045e09f4fa56cdef66076447, type: 3}
    narrativeText: "M\u1ED9t l\u0169 qu\xE1i v\u1EADt t\u1EEB \u0111\xE2u xu\u1EA5t
      hi\u1EC7n. Ch\xFAng kh\xF4ng ch\u1EC9 t\xE0n ph\xE1 t\xFAp l\u1EC1u, m\xE0
      c\xF2n c\u01B0\u1EDBp \u0111i k\u1EF7 v\u1EADt thi\xEAng li\xEAng \u1EA5y."
  - illustration: {fileID: 1385043987589415079, guid: b47ab769378fd0e4eaa6650b8f6a3243, type: 3}
    narrativeText: "Ta \u0111\xE3 bi\u1EBFt v\u1EC1 truy\u1EC1n thuy\u1EBFt 7 vi\xEAn
      Ng\u1ECDc R\u1ED3ng. Ch\u1EC9 c\u1EA7n thu th\u1EADp \u0111\u1EE7 ch\xFAng,
      ta s\u1EBD c\xF3 th\u1EC3 h\u1ED3i sinh \xF4ng n\u1ED9i... v\xE0 l\u1EA5y l\u1EA1i
      \u0111\u01B0\u1EE3c k\u1EF7 v\u1EADt c\u1EE7a m\xECnh!"
  nextLevelName: LangAru
  forceShowIntro: 1
